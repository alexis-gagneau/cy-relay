# CYU student account — copy this file to .env and fill it in.
# .env is git-ignored: never commit real credentials.

# Numeric student id — the number after "fid0=" in your timetable URL.
CYU_ID=YOUR_STUDENT_ID

# Your CYU directory login (the one used on celcat-calendar.cyu.fr).
CYU_USERNAME=e-yourcyulogin

# Your CYU password.
CYU_PASSWORD=YOUR_CYU_PASSWORD

# Optional schedules (node-cron, Europe/Paris). SCHEDULE is the default
# cadence for every service; CELCAT_SCHEDULE / MAIL_SCHEDULE override it per
# service (the mailbox probe is a single light GET — a short interval is fine).
#SCHEDULE=*/10 * * * *
#CELCAT_SCHEDULE=*/10 * * * *
#MAIL_SCHEDULE=*/3

# Log level: debug | info | warn | error (default: info). debug shows the
# SSO flow step-by-step and every network retry.
#LOG_LEVEL=debug

# Mail relay: the student mailbox is polled and every new unread message is
# transferred as-is to MAIL_NOTIFY_TO (Reply-To keeps the real sender).
MAIL_ADDRESS=your.name@etu.cyu.fr
MAIL_NOTIFY_TO=you@personal.example

# Optional: poll the mailbox on its own cadence (cron, Europe/Paris),
# decoupled from SCHEDULE. A probe is a single light inbox GET (the session
# cookie persists, no re-login), so a short interval costs nothing:
#MAIL_SCHEDULE=*/3

# Active window for all tickers (local hours, Europe/Paris): when set, nothing
# is scraped or polled outside it — overnight mail transfers at the first tick
# of the window. Unset = 24/7.
#ACTIVE_WINDOW=8-20
