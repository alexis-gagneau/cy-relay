# CYU student account — copy this file to .env and fill it in.
# .env is git-ignored: never commit real credentials.

# ─── Login (required) ────────────────────────────────────────────────────────

# Numeric student id — the number after "fid0=" in your timetable URL.
CYU_ID=YOUR_STUDENT_ID

# Your CYU directory login (the one used on celcat-calendar.cyu.fr).
CYU_USERNAME=e-yourcyulogin

# Your CYU password.
CYU_PASSWORD=YOUR_CYU_PASSWORD

# ─── Mail relay (optional) ───────────────────────────────────────────────────
# The student mailbox is polled and every new unread message is transferred
# as-is to MAIL_NOTIFY_TO (Reply-To keeps the real sender). Unset = relay off.
#MAIL_ADDRESS=your.name@etu.cyu.fr
#MAIL_NOTIFY_TO=you@personal.example

# ─── Schedules (optional, cron, Europe/Paris) ────────────────────────────────
# SCHEDULE is the default cadence for every service; CELCAT_SCHEDULE /
# MAIL_SCHEDULE override it per service (the mailbox probe is a single light
# GET — a short interval is fine).
#SCHEDULE=*/10 * * * *
#CELCAT_SCHEDULE=*/10 * * * *
#MAIL_SCHEDULE=*/3 * * * *

# ─── Active window (optional) ────────────────────────────────────────────────
# Ticks only run between those local hours: nothing is scraped or polled
# outside it — overnight mail transfers at the first tick of the window.
# Unset = 24/7.
#ACTIVE_WINDOW=8-20

# ─── Verbose logs (optional) ─────────────────────────────────────────────────
# debug | info | warn | error (default: info). debug shows the SSO flow
# step-by-step and every network retry.
#LOG_LEVEL=debug
